{
  "name": "moviebox-backend",
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev --port 8787 --var APP_ENV:development",
    "dev:remote": "bunx wrangler dev --remote --port 8787 --var APP_ENV:development",
    "deploy": "bash scripts/deploy.sh",
    "deploy:quick": "bunx wrangler deploy --minify",
    "cf-typegen": "bunx wrangler types --env-interface CloudflareBindings",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:strict": "oxlint . --deny-warnings",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "smoke": "node scripts/smoke-worker.mjs",
    "smoke:dev": "MOVIEBOX_WORKER_URL=http://127.0.0.1:8787 node scripts/smoke-worker.mjs",
    "smoke:prod": "MOVIEBOX_WORKER_URL=https://moviebox-backend.rahulmarban.workers.dev node scripts/smoke-worker.mjs",
    "smoke:local": "MOVIEBOX_WORKER_URL=http://127.0.0.1:8787 node scripts/smoke-worker.mjs",
    "verify:rt": "node scripts/verify-rotten-tomatoes.mjs",
    "cache:purge": "node --experimental-strip-types scripts/purge-cache.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "hono": "^4.12.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.16.0",
    "wrangler": "^4.4.0"
  }
}
