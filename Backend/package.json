{
  "name": "moviebox-backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var APP_ENV:development",
    "dev:remote": "wrangler dev --remote --port 8787 --var APP_ENV:development",
    "deploy": "bash scripts/deploy.sh",
    "deploy:quick": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:strict": "oxlint . --deny-warnings",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "smoke": "node scripts/smoke-worker.mjs",
    "smoke:dev": "MOVIEBOX_WORKER_URL=http://127.0.0.1:8787 node scripts/smoke-worker.mjs",
    "smoke:prod": "MOVIEBOX_WORKER_URL=https://moviebox-backend.rahulmarban.workers.dev node scripts/smoke-worker.mjs",
    "smoke:local": "MOVIEBOX_WORKER_URL=http://127.0.0.1:8787 node scripts/smoke-worker.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "hono": "^4.12.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.6",
    "@types/node": "^25.8.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.16.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.4.0"
  }
}
